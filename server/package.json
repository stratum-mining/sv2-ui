{
  "name": "sv2-ui-server",
  "version": "0.1.0",
  "description": "Backend server for sv2-ui Docker orchestration",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --import tsx dist/index.js",
    "test": "node --test --import tsx src/*.test.ts src/**/*.test.ts"
  },
  "dependencies": {
    "@sv2-ui/shared": "*",
    "bs58check": "^4.0.0",
    "dockerode": "^5.0.1",
    "express": "^4.18.2",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.23",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "typescript": "^5.3.0"
  }
}
